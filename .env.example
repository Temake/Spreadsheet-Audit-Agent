# Copy to .env and fill in. Never commit .env.

# --- LLM (Claude on AWS Bedrock) ---
# The Bedrock model or inference-profile ID for Claude, copied from the Bedrock console.
AUDIT_BEDROCK_MODEL_ID=
# Optional; falls back to the AWS default region (AWS_REGION / ~/.aws/config).
AUDIT_AWS_REGION=

# AWS credentials come from the standard AWS chain (env vars, ~/.aws profile, SSO, or IAM role).
# Prefer a named profile over raw keys:
# AWS_PROFILE=my-bedrock-profile

# --- Limits (defaults shown) ---
# AUDIT_MAX_FILE_MB=10
# AUDIT_MAX_ROWS=100000
# AUDIT_MAX_COLUMNS=200
# AUDIT_MAX_AGENT_STEPS=25
# AUDIT_MIN_RULE_SUPPORT=0.9

# Set to false to stop sending any cell values (top values, examples) to the LLM.
# The agent then sees only column names, types, and statistics.
# AUDIT_SHARE_SAMPLE_VALUES=true
